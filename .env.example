# Copie para .env e preencha. Nada aqui vai para o Git (.env está no .gitignore).

# --- Execução ---------------------------------------------------------------
# 1 = modo ensaio: nada é publicado, a prévia vai para o Discord
DRY_RUN=1
# Para o ensaio use "Grand Theft Auto V"; no lançamento "Grand Theft Auto VI"
TWITCH_GAME_NAME=Grand Theft Auto V
# Deixe vazio rodando local (o túnel da Cloudflare é descoberto sozinho)
PUBLIC_BASE_URL=

# --- Twitch (dev.twitch.tv) ----------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Gerado com: uv run python scripts/twitch_oauth.py <client_id> <client_secret>
TWITCH_BOT_REFRESH_TOKEN=

# --- Kick (não oficial; ligue só se o teste da Tarefa 0 funcionou) -------------
KICK_ENABLED=0
KICK_CATEGORY_SLUG=grand-theft-auto-vi

# --- IA ----------------------------------------------------------------------
GEMINI_API_KEY=
# Vários modelos em ordem de preferência: se um falhar ou estiver sobrecarregado, tenta o próximo
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash
# Reserva paga quando o Gemini falhar
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_DAILY_BUDGET_USD=3
# Transcrição (legendas)
GROQ_API_KEY=

# --- Discord -----------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_USER_ID=

# --- Instagram (Graph API) ---------------------------------------------------
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

# --- TikTok (off | private | public — public só após a auditoria) --------------
TIKTOK_MODE=off
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- YouTube Shorts (off | private | public — public só após a auditoria) ------
YT_MODE=off
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Ajustes finos (padrões da spec) --------------------------------------------
MONITOR_MAX_CHANNELS=200
SPIKE_MULTIPLIER=3
SPIKE_MIN_MSGS=15
CLIP_RATE_SECONDS=20
RANK_THRESHOLD=5
AI_DAILY_BUDGET=300
AI_MIN_SCORE=7
POST_MIN_INTERVAL_MIN=45
POST_MAX_PER_DAY=8
POST_MAX_PER_DAY_STEP=2
POST_MAX_PER_DAY_CAP=20
QUEUE_TTL_MIN=90

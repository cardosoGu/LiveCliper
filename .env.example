# Copie para .env e preencha. Nada aqui vai para o Git (.env está no .gitignore).

# --- Execução ---------------------------------------------------------------
# Plataformas começam ligadas; DRY_RUN=1 faz todas começarem desligadas (depois, /plataforma no Discord)
DRY_RUN=0
# Deixe vazio rodando local (o túnel da Cloudflare é descoberto sozinho)
PUBLIC_BASE_URL=

# --- Twitch (opcional: só para cortar live em andamento da Twitch) -----------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- IA ----------------------------------------------------------------------
# uma ou mais chaves; para cada modelo, tenta a 1, depois a 2, depois a 3
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
# Vários modelos em ordem de preferência: se um falhar ou estiver sobrecarregado, tenta o próximo
GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash
# Transcrição (legendas)
GROQ_API_KEY=

# --- Discord -----------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_USER_ID=
# DISCORD_CHANNEL_ID acima é o #logs. Os outros canais: informe o ID, ou deixe vazio para o bot
# criar (na categoria "Live Clips"; aí ele precisa da permissão "Gerenciar canais").
# O canal de links precisa do "Message Content Intent" ligado no Developer Portal.
DISCORD_UPLOAD_LIMIT_MB=10
DISCORD_APPROVAL_CHANNEL_ID=
DISCORD_PANEL_CHANNEL_ID=
DISCORD_LINKS_CHANNEL_ID=

# --- Instagram (Graph API) ---------------------------------------------------
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

# --- TikTok (off | draft | private | public — draft = rascunho no app; public só após a auditoria) --------------
TIKTOK_MODE=off
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- YouTube Shorts (off | private | public — public só após a auditoria) ------
YT_MODE=off
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Ajustes finos --------------------------------------------------------------
AI_DAILY_BUDGET=300
AI_MIN_SCORE=6
POST_MIN_INTERVAL_MIN=45
POST_MAX_PER_DAY=8
# Duração máxima de um vídeo gravado (horas); numa live em andamento, pega as últimas N horas
ONDEMAND_MAX_HOURS=4
